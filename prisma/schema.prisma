generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ****************** TENANT ******************

model Tenant {
  id     String  @id @default(cuid(2))
  name   String  @unique
  active Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("TenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sites       Site[]
  users       User[]
  memberships UserTenant[]

  typeparcs        Typeparc[]
  parcs            Parc[]
  engins           Engin[]
  typepannes       Typepanne[]
  pannes           Panne[]
  saisiehrms       Saisiehrm[]
  saisiehims       Saisiehim[]
  objectifs        Objectif[]
  backlogs         Backlog[]
  plansMaintenance PlanMaintenance[]

  affectationsPlansMaintenance AffectationPlanMaintenance[]
  suivisPlansMaintenance       SuiviPlanMaintenanceEngin[]

  @@map("tenant")
}

// ****************** GESTION DES USERS PERMISSIONS & ROLES ******************

// implicite relation between Permission and Role
model Permission {
  id          String  @id @default(cuid(2))
  name        String  @unique
  resource    String
  action      Action
  description String?

  roles Role[]

  @@unique([resource, action])
  @@map("permission")
}

enum Action {
  create
  read
  update
  delete
  export
  import
}

model Role {
  id          String  @id @default(cuid(2))
  name        String
  description String?

  permissions     Permission[]
  userAssignments UserTenantRole[]

  @@unique([name])
  @@map("role")
}

model User {
  id           String  @id @default(cuid(2))
  tenantId     String?
  name         String
  email        String  @unique
  password     String
  active       Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  createdTenants Tenant[] @relation("TenantCreatedBy")

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  memberships UserTenant[]

  @@unique([isSuperAdmin], where: { isSuperAdmin: true }, map: "user_single_super_admin_key")
  @@map("user")
}

model UserTenant {
  userId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleAssignments UserTenantRole[]

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenant")
}

model UserTenantRole {
  userId   String
  tenantId String
  roleId   String

  membership UserTenant @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("user_tenant_role")
}

// ****************** GESTION DES DONNEES DE BASE ******************

model Site {
  id       String  @id @default(cuid(2))
  name     String
  active   Boolean @default(true)
  tenantId String

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  engins     Engin[]
  saisiehrms Saisiehrm[]
  objectifs  Objectif[]
  backlogs   Backlog[]

  affectationsMaintenance AffectationPlanMaintenance[]

  @@unique([name, tenantId])
  @@map("site")
}

model Typeparc {
  id       String @id @default(cuid(2))
  name     String
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parcs  Parc[]

  affectationsMaintenance AffectationPlanMaintenance[]

  @@unique([name, tenantId])
  @@map("typeparc")
}

model Parc {
  id         String @id @default(cuid(2))
  name       String
  typeparcId String
  tenantId   String

  // Relation 1-M avec Typeparc
  typeparc Typeparc @relation(fields: [typeparcId], references: [id], onDelete: Restrict)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  engins    Engin[]
  pannes    Panne[]
  objectifs Objectif[]

  affectationsMaintenance AffectationPlanMaintenance[]

  @@unique([name, tenantId])
  @@map("parc")
}

model Engin {
  id                  String  @id @default(cuid(2))
  name                String
  active              Boolean @default(true)
  parcId              String
  siteId              String
  initialHeureChassis Float?  @default(0)
  tenantId            String

  // Relations
  parc       Parc        @relation(fields: [parcId], references: [id], onDelete: Restrict)
  site       Site        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  saisiehrms Saisiehrm[]
  backlogs   Backlog[]

  affectationsMaintenance AffectationPlanMaintenance[]
  suivisPlansMaintenance  SuiviPlanMaintenanceEngin[]

  @@unique([name, tenantId])
  @@map("engin")
}

model Typepanne {
  id          String  @id @default(cuid(2))
  name        String
  description String?
  tenantId    String

  // Relations
  pannes Panne[] // ← Relation many-to-many implicite

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([name, tenantId])
  @@map("typepanne")
}

model Panne {
  id          String  @id @default(cuid(2))
  name        String
  description String?
  typepanneId String
  tenantId    String

  // Relations
  typepanne Typepanne @relation(fields: [typepanneId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  saisiehims Saisiehim[]
  parcs      Parc[]

  @@unique([name, tenantId])
  @@map("panne")
}

model Saisiehrm {
  id       String   @id @default(cuid(2))
  du       DateTime @db.Date
  enginId  String
  siteId   String
  hrm      Float
  compteur Float?
  tenantId String

  // Relations
  engin  Engin  @relation(fields: [enginId], references: [id], onDelete: Restrict)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  saisiehim Saisiehim[]

  @@unique([du, enginId, tenantId])
  @@map("saisie_hrm")
}

model Saisiehim {
  id          String  @id @default(cuid(2))
  panneId     String
  him         Float
  ni          Int?
  saisiehrmId String
  obs         String?
  tenantId    String

  // Relations
  panne     Panne     @relation(fields: [panneId], references: [id], onDelete: Restrict)
  saisiehrm Saisiehrm @relation(fields: [saisiehrmId], references: [id], onDelete: Restrict)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([panneId, saisiehrmId, tenantId])
  @@map("saisie_him")
}

model Objectif {
  id          String @id @default(cuid(2))
  annee       Int
  parcId      String
  siteId      String
  dispo       Float?
  mtbf        Float?
  tdm         Float?
  spe_huile   Float?
  spe_go      Float?
  spe_graisse Float?
  tenantId    String

  // Relations
  parc   Parc   @relation(fields: [parcId], references: [id], onDelete: Restrict)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([annee, parcId, siteId])
  @@map("objectif")
}

// ****************** GESTION DES BACKLOGS ******************

enum SourceBacklog {
  VS
  VJ
  INSPECTION
  AUTRE
}

enum PrioriteBacklog {
  ELEVEE
  MOYENNE
  FAIBLE
}

enum StatutBacklog {
  ATTENTE_PROGRAMME
  ATTENTE_PDR
  PDR_PRET
  PROGRAMMEE
  EXECUTE
}

model Backlog {
  id            String          @id @default(cuid(2))
  numeroBacklog String
  dateDetection DateTime        @db.Date
  description   String
  source        SourceBacklog
  priorite      PrioriteBacklog
  equipe        String?
  statut        StatutBacklog   @default(ATTENTE_PROGRAMME)
  dateExecution DateTime?       @db.Date
  observations  String? // quantite, reference, code, numeroBS

  enginId  String
  siteId   String
  tenantId String

  engin  Engin  @relation(fields: [enginId], references: [id], onDelete: Restrict)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  historiqueStatutBacklogs HistoriqueStatutBacklog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un numéro peut exister dans deux tenants différents,
  // mais pas deux fois dans le même tenant.
  @@unique([numeroBacklog, tenantId])
  @@index([tenantId, dateDetection])
  @@index([tenantId, statut])
  @@map("backlog")
}

model HistoriqueStatutBacklog {
  id             String        @id @default(cuid(2))
  backlogId      String
  ancienStatut   StatutBacklog
  nouveauStatut  StatutBacklog
  dateChangement DateTime      @default(now())
  commentaire    String?

  backlog Backlog @relation(fields: [backlogId], references: [id], onDelete: Cascade)

  @@index([backlogId, dateChangement])
  @@map("historique_statut_backlog")
}

// ******************
// MAINTENANCE PRÉVENTIVE
// ******************

model PlanMaintenance {
  id                String  @id @default(cuid(2))
  code              String
  name              String
  description       String?
  intervalleHeures  Float
  seuilAlerteHeures Float   @default(50)
  active            Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  affectations AffectationPlanMaintenance[]
  suivisEngins SuiviPlanMaintenanceEngin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, tenantId])
  @@index([tenantId, active])
  @@map("plan_maintenance")
}

enum PorteeAffectationMaintenance {
  TYPEPARC
  PARC
  SITE
  ENGIN
}

model AffectationPlanMaintenance {
  id                String                       @id @default(cuid(2))
  planMaintenanceId String
  tenantId          String
  portee            PorteeAffectationMaintenance
  typeparcId        String?
  parcId            String?
  siteId            String?
  enginId           String?
  active            Boolean                      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planMaintenance PlanMaintenance @relation(fields: [planMaintenanceId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  typeparc Typeparc? @relation(fields: [typeparcId], references: [id], onDelete: Restrict)

  parc Parc? @relation(fields: [parcId], references: [id], onDelete: Restrict)

  site Site? @relation(fields: [siteId], references: [id], onDelete: Restrict)

  engin Engin? @relation(fields: [enginId], references: [id], onDelete: Restrict)

  @@unique([planMaintenanceId, tenantId, typeparcId])
  @@unique([planMaintenanceId, tenantId, parcId])
  @@unique([planMaintenanceId, tenantId, siteId])
  @@unique([planMaintenanceId, tenantId, enginId])
  @@index([tenantId, portee, active])
  @@index([planMaintenanceId, active])
  @@map("affectation_plan_maintenance")
}

model SuiviPlanMaintenanceEngin {
  id                String  @id @default(cuid(2))
  planMaintenanceId String
  enginId           String
  tenantId          String
  active            Boolean @default(true)

  // Null signifie que le compteur de la dernière maintenance
  // réelle n'a pas encore été renseigné.
  compteurDerniereMaintenance Float?
  dateDerniereMaintenance     DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planMaintenance PlanMaintenance @relation(fields: [planMaintenanceId], references: [id], onDelete: Restrict)

  engin Engin @relation(fields: [enginId], references: [id], onDelete: Restrict)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([planMaintenanceId, enginId, tenantId])
  @@index([tenantId, enginId])
  @@map("suivi_plan_maintenance_engin")
}
