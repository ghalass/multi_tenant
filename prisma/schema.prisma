generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ****************** TENANT ******************

model Tenant {
  id     String  @id @default(cuid(2))
  name   String  @unique
  active Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("TenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sites      Site[]
  users      User[]
  typeparcs  Typeparc[]
  parcs      Parc[]
  engins     Engin[]
  typepannes Typepanne[]
  pannes     Panne[]
  saisiehrms Saisiehrm[]
  saisiehims Saisiehim[]

  @@map("tenant")
}

// ****************** GESTION DES USERS PERMISSIONS & ROLES ******************

// implicite relation between Permission and Role
model Permission {
  id          String  @id @default(cuid(2))
  name        String  @unique
  resource    String
  action      Action
  description String?

  roles Role[]

  @@unique([resource, action])
  @@map("permission")
}

enum Action {
  create
  read
  update
  delete
  export
}

model Role {
  id          String  @id @default(cuid(2))
  name        String
  description String?

  permissions Permission[]
  users       User[]

  @@unique([name])
  @@map("role")
}

model User {
  id           String  @id @default(cuid(2))
  tenantId     String?
  name         String
  email        String
  password     String
  active       Boolean @default(true)
  isSuperAdmin Boolean @default(false)

  createdTenants Tenant[] @relation("TenantCreatedBy")

  roles  Role[]
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@map("user")
}

// ****************** GESTION DES DONNEES DE BASE ******************

model Site {
  id       String  @id @default(cuid(2))
  name     String
  active   Boolean @default(true)
  tenantId String

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engins     Engin[]
  saisiehrms Saisiehrm[]

  @@unique([name, tenantId])
  @@map("site")
}

model Typeparc {
  id       String @id @default(cuid(2))
  name     String
  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parcs  Parc[]

  @@unique([name, tenantId])
  @@map("typeparc")
}

model Parc {
  id         String @id @default(cuid(2))
  name       String
  typeparcId String
  tenantId   String

  // engins               Engin[]

  // Relation 1-M avec Typeparc
  typeparc Typeparc @relation(fields: [typeparcId], references: [id], onDelete: Restrict)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engins   Engin[]
  panne    Panne?   @relation(fields: [panneId], references: [id])
  panneId  String?

  @@unique([name, tenantId])
  @@map("parc")
}

model Engin {
  id                  String  @id @default(cuid(2))
  name                String
  active              Boolean @default(true)
  parcId              String
  siteId              String
  initialHeureChassis Float?  @default(0)
  tenantId            String

  // Relations
  parc       Parc        @relation(fields: [parcId], references: [id], onDelete: Restrict)
  site       Site        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saisiehrms Saisiehrm[]
  saisiehims Saisiehim[]

  @@unique([name, tenantId])
  @@map("engin")
}

model Typepanne {
  id          String  @id @default(cuid(2))
  name        String
  description String?
  tenantId    String

  // Relations
  pannes Panne[] // ← Relation many-to-many implicite

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([name, tenantId])
  @@map("typepanne")
}

model Panne {
  id          String  @id @default(cuid(2))
  name        String
  description String?
  typepanneId String
  tenantId    String

  // Relations
  typepanne Typepanne @relation(fields: [typepanneId], references: [id], onDelete: Restrict)

  parcs      Parc[] // ← Relation many-to-many implicite avec Parc
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saisiehims Saisiehim[]

  @@unique([name, tenantId])
  @@map("panne")
}

model Saisiehrm {
  id       String   @id @default(cuid(2))
  du       DateTime
  enginId  String
  siteId   String
  hrm      Float
  compteur Float?
  tenantId String

  // Relations
  engin     Engin       @relation(fields: [enginId], references: [id], onDelete: Restrict)
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saisiehim Saisiehim[]

  @@unique([du, enginId, tenantId])
  @@map("saisie_hrm")
}

model Saisiehim {
  id          String  @id @default(cuid(2))
  panneId     String
  him         Float
  ni          Int
  saisiehrmId String
  obs         String?
  tenantId    String

  // Relations
  panne     Panne     @relation(fields: [panneId], references: [id], onDelete: Restrict)
  saisiehrm Saisiehrm @relation(fields: [saisiehrmId], references: [id], onDelete: Restrict)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engin     Engin     @relation(fields: [enginId], references: [id])
  enginId   String

  @@unique([panneId, saisiehrmId, tenantId])
  @@map("saisie_him")
}
